# Get a key at https://jpx-jquants.com → dashboard → API Keys
JQUANTS_API_KEY=
# free | light | standard | premium  (sets the rate limit and history window)
JQUANTS_PLAN=free
# Comma-separated issue codes to track in full (4 or 5 digits)
JQUANTS_WATCHLIST=7203,6758,8306,9984,6861
JQUANTS_DB=data/jquantster.db
# Optional: FSA EDINET filings. Free key at https://api.edinet-fsa.go.jp/api/auth/index.aspx?mode=1
# EDINET_API_KEY=
# Days of filings to fetch on the first sync
# EDINET_HISTORY_DAYS=365
